{
	"cli": {
		"version": ">= 16.28.0",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal"
		},
		"preview": {
			"distribution": "internal",
			"node": "22.14.0",
			"env": {
				"SENTRY_DISABLE_AUTO_UPLOAD": "true"
			},
			"android": {
				"buildType": "apk"
			}
		},
		"production": {
			"node": "22.14.0",
			"autoIncrement": true,
			"android": {
				"buildType": "app-bundle"
			},
			"ios": {
				"buildConfiguration": "Release"
			},
			"env": {
				"SENTRY_DISABLE_AUTO_UPLOAD": "true"
			}
		}
	},
	"submit": {
		"production": {
			"android": {
				"serviceAccountKeyPath": "./google-play-key.json",
				"track": "internal",
				"releaseStatus": "draft"
			},
			"ios": {
				"appleId": "ezkielvictor2700@gmail.com",
				"appleTeamId": "63GVNP37V2",
				"ascAppId": "6837457805"
			}
		}
	}
}
